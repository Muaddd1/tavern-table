# Multiplayer on Vercel needs all three of these. Without them, rooms are switched off there
# (local `npm run dev` or `npm start` uses an in-memory store instead).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Signs the room channel names.
ROOM_CHANNEL_SECRET=
# Direct (non-pooling) Postgres URL, used only by scripts/migrate.mjs. `vercel env pull` fills it in
# when the Supabase integration is connected.
POSTGRES_URL_NON_POOLING=

# AI features: import, Create with AI, Ask the rules, AI DM. Paid per use; off when empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_DAILY_PER_USER=50
AI_DAILY_TOTAL=500
